{
  "name": "@maximus/quiz",
  "version": "0.1.0",
  "description": "Standalone, attribute-driven marketing quiz engine. Zero dependencies, no AI. Wires behavior onto author-supplied data-quiz-* markup; aggregates answers to browser storage and carries them across subdomains; self-lints its own configuration.",
  "type": "module",
  "main": "dist/maximus-quiz.mjs",
  "module": "dist/maximus-quiz.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/maximus-quiz.mjs"
    },
    "./authoring": {
      "types": "./dist/authoring/index.d.ts",
      "import": "./dist/authoring.mjs"
    },
    "./iife": "./dist/maximus-quiz.iife.js",
    "./theme.css": "./dist/maximus-quiz.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs && tsc --emitDeclarationOnly --outDir dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.{ts,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "quiz:generate": "node scripts/generate-quiz.mjs",
    "quiz:verify": "node scripts/verify-quiz.mjs",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "keywords": [
    "quiz",
    "marketing",
    "attribute-driven",
    "personalization",
    "standalone",
    "typescript"
  ],
  "author": "Maximus",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.17.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
